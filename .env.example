# Copy this file to .env and fill in real values. Never commit .env to version control.

# Anthropic API key — required for AI enrichment (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Flask session signing key — use a long random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Set to "true" only for local development. NEVER enable in production.
FLASK_DEBUG=false
